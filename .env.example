# Env vars ending in _API_KEY show up in the UI's "From .env" dropdown
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=
CF_UNIFIED_API_KEY=
AI302_API_KEY=

# AWS Bedrock: when set, the proxy signs with these server-side credentials
# and the UI credential fields can be left blank (keys never reach the browser)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials (STS / SSO)
AWS_SESSION_TOKEN=

# Local development switch (do NOT enable on a public deployment):
# when set to 1, the server exposes the *_API_KEY dropdown to the UI and
# allows /api/run to sign with the AWS credentials above
LPB_ENABLE_SERVER_KEYS=1
